   "source": [
    "standard = deliveries[deliveries[\"inning\"].isin([1,2])].copy()\n",
    "standard[\"is_wicket\"] = standard[\"player_dismissed\"].notna().astype(int)\n",
    "standard[\"is_four\"] = standard[\"batsman_runs\"].eq(4).astype(int)\n",
    "standard[\"is_six\"] = standard[\"batsman_runs\"].eq(6).astype(int)\n",
    "\n",
    "innings = standard.groupby([\"match_id\",\"inning\",\"batting_team\",\"bowling_team\"]).agg(\n",
    "    runs=(\"total_runs\",\"sum\"), wickets=(\"is_wicket\",\"sum\"),\n",
    "    legal_balls=(\"is_legal_ball\",\"sum\"), fours=(\"is_four\",\"sum\"), sixes=(\"is_six\",\"sum\")\n",
    ").reset_index()\n",
    "display(innings.head())\n",
    "phase_stats = standard.groupby(\"over_phase\").agg(\n",
    "    runs=(\"total_runs\",\"sum\"), legal_balls=(\"is_legal_ball\",\"sum\"),\n",
    "    fours=(\"is_four\",\"sum\"), sixes=(\"is_six\",\"sum\"), wickets=(\"is_wicket\",\"sum\")\n",
    ")\n",
    "phase_stats[\"run_rate\"] = (phase_stats[\"runs\"]/(phase_stats[\"legal_balls\"]/6)).round(2)\n",
    "display(phase_stats.reindex([\"Powerplay\",\"Middle\",\"Death\"]))\n",
    "phase_stats[\"run_rate\"].reindex([\"Powerplay\",\"Middle\",\"Death\"]).plot(kind=\"bar\",figsize=(7,4),title=\"Run rate by innings phase\")\n",
    "plt.ylabel(\"Runs per over\"); plt.xlabel(\"\"); plt.xticks(rotation=0); plt.tight_layout(); plt.show()"
   ]
  },
