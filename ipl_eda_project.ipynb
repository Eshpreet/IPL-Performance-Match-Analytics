    "appearances = pd.concat([\n",
    "    matches[[\"match_id\",\"team1\"]].rename(columns={\"team1\":\"team\"}),\n",
    "    matches[[\"match_id\",\"team2\"]].rename(columns={\"team2\":\"team\"})\n",
    "])\n",
    "played = appearances.groupby(\"team\")[\"match_id\"].nunique()\n",
    "wins = matches.dropna(subset=[\"winner\"]).groupby(\"winner\")[\"match_id\"].nunique()\n",
    "team_stats = pd.DataFrame({\"matches_played\":played, \"wins\":wins}).fillna(0)\n",
    "team_stats[\"win_pct\"] = (100*team_stats[\"wins\"]/team_stats[\"matches_played\"]).round(2)\n",
    "team_stats = team_stats.sort_values([\"wins\",\"win_pct\"],ascending=False)\n",
    "display(team_stats.head(15))\n",
    "ax = team_stats.head(10).sort_values(\"wins\")[\"wins\"].plot(kind=\"barh\",figsize=(9,5),title=\"Top teams by recorded wins\")\n",
    "ax.set_xlabel(\"Wins\"); ax.set_ylabel(\"\"); plt.tight_layout(); plt.show()"
   ]
  },
