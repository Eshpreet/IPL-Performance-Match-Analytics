   "source": [
    "batting = deliveries.groupby(\"batsman\").agg(\n",
    "    runs=(\"batsman_runs\",\"sum\"),\n",
    "    matches=(\"match_id\",\"nunique\")\n",
    ")\n",
    "balls_faced = deliveries.loc[deliveries[\"is_wide_flag\"].eq(0)].groupby(\"batsman\").size()\n",
    "dismissals = deliveries.loc[deliveries[\"player_dismissed\"].notna()].groupby(\"player_dismissed\").size()\n",
    "batting[\"balls_faced\"] = balls_faced\n",
    "batting[\"dismissals\"] = dismissals\n",
    "batting[[\"balls_faced\",\"dismissals\"]] = batting[[\"balls_faced\",\"dismissals\"]].fillna(0)\n",
    "batting[\"strike_rate\"] = (100*batting[\"runs\"]/batting[\"balls_faced\"].replace(0,np.nan)).round(2)\n",
    "batting = batting.sort_values(\"runs\",ascending=False)\n",
    "display(batting.head(15))\n",
    "batting.head(10).sort_values(\"runs\")[\"runs\"].plot(kind=\"barh\",figsize=(9,5),title=\"Top run scorers\")\n",
    "plt.xlabel(\"Runs\"); plt.ylabel(\"\"); plt.tight_layout(); plt.show()"
   ]
  },
