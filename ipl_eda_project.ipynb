   "source": [
    "bowling = deliveries.groupby(\"bowler\").agg(\n",
    "    legal_balls=(\"is_legal_ball\",\"sum\"),\n",
    "    runs_conceded=(\"bowler_runs_conceded\",\"sum\"),\n",
    "    wickets=(\"bowler_wicket\",\"sum\"),\n",
    "    matches=(\"match_id\",\"nunique\")\n",
    ")\n",
    "bowling[\"overs\"] = bowling[\"legal_balls\"]/6\n",
    "bowling[\"economy\"] = (bowling[\"runs_conceded\"]/bowling[\"overs\"].replace(0,np.nan)).round(2)\n",
    "bowling = bowling.sort_values([\"wickets\",\"economy\"],ascending=[False,True])\n",
    "display(bowling.head(15))\n",
    "bowling.head(10).sort_values(\"wickets\")[\"wickets\"].plot(kind=\"barh\",figsize=(9,5),title=\"Top wicket takers\")\n",
    "plt.xlabel(\"Bowler-credited wickets\"); plt.ylabel(\"\"); plt.tight_layout(); plt.show()"
   ]
  },
