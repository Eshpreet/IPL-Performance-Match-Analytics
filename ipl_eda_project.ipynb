   "source": [
    "decided = matches.dropna(subset=[\"winner\",\"toss_winner\"]).copy()\n",
    "decided[\"toss_winner_won_match\"] = decided[\"winner\"].eq(decided[\"toss_winner\"])\n",
    "toss_stats = decided.groupby(\"toss_decision\").agg(\n",
    "    matches=(\"match_id\",\"nunique\"),\n",
    "    toss_winner_match_wins=(\"toss_winner_won_match\",\"sum\")\n",
    ")\n",
    "toss_stats[\"win_pct\"] = (100*toss_stats[\"toss_winner_match_wins\"]/toss_stats[\"matches\"]).round(2)\n",
    "display(toss_stats)\n",
    "print(\"Overall toss winner also won match:\",\n",
    "      f\"{100*decided['toss_winner_won_match'].mean():.2f}%\")"
   ]
  },
