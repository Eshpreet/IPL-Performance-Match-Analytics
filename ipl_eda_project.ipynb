   "source": [
    "venue_stats = matches.groupby(\"venue\").agg(\n",
    "    matches=(\"match_id\",\"nunique\"),\n",
    "    teams_winning_first=(\"winner_runs\",lambda s:s.notna().sum())\n",
    ").sort_values(\"matches\",ascending=False)\n",
    "season_stats = matches.groupby(\"season\").agg(\n",
    "    matches=(\"match_id\",\"nunique\"),\n",
    "    decided_matches=(\"winner\",lambda s:s.notna().sum())\n",
    ").reset_index()\n",
    "display(venue_stats.head(15))\n",
    "display(season_stats)"
   ]
  },
