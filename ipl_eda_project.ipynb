    "print(f\"Seasons: {matches['season'].nunique()}\")\n",
    "print(f\"Recorded teams/franchise names: {pd.concat([matches.team1, matches.team2]).nunique()}\")\n",
    "print(f\"Matches with a recorded winner: {decided_matches:,}\")\n",
    "print(f\"Total runs in delivery data: {total_runs:,}\")\n",
    "print(f\"Legal deliveries: {legal_balls:,}\")"
   ]
